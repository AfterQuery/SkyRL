# API keys for MCP-Atlas. Load with `uv run --env-file examples/train/mcp_atlas/.env.mcp_atlas ...`
# (the run scripts do this for you).
#
# THIS FILE IS COMMITTED -- keep only placeholders here. Put real secrets in
# `.env.mcp_atlas.local` (gitignored) and pass that file instead, or export them in your shell.

# ---------------------------------------------------------------------------
# Judge -- REQUIRED. This is the reward signal: claim coverage in [0,1].
# Must not point at the policy being trained. The upstream default judge is
# gemini/gemini-3.1-pro-preview; any OpenAI-compatible endpoint works.
# ---------------------------------------------------------------------------
MCP_ATLAS_JUDGE_BASE_URL=
MCP_ATLAS_JUDGE_KEY=
MCP_ATLAS_JUDGE_MODEL=

# ---------------------------------------------------------------------------
# Agent inference key -- the key the in-container loop uses for the policy.
# A locally served vLLM ignores it, but the runner refuses to start without one.
# ---------------------------------------------------------------------------
MCP_ATLAS_API_KEY=

# ---------------------------------------------------------------------------
# Daytona -- REQUIRED when harbor_trial_config.yaml uses `environment.type: daytona`
# (the default). Either DAYTONA_API_KEY, or both DAYTONA_JWT_TOKEN and
# DAYTONA_ORGANIZATION_ID. DAYTONA_TARGET optionally selects a region.
# Not needed for `type: docker`.
# ---------------------------------------------------------------------------
DAYTONA_API_KEY=
DAYTONA_TARGET=

# ---------------------------------------------------------------------------
# MCP server keys -- OPTIONAL, one per key-gated server. Only 35 of the 500
# upstream tasks need no keys at all; these unlock the rest. Any server whose
# keys are absent is simply not enabled, and tasks needing it will fail.
#
# Mostly irrelevant for the AQ-1000 set, whose services are simulated inside the
# task image. They matter for the upstream 500, where the servers are real; those
# are forwarded into the task container via harbor_trial_config.yaml.
# ---------------------------------------------------------------------------
AIRTABLE_API_KEY=
ALCHEMY_API_KEY=
BRAVE_API_KEY=
E2B_API_KEY=
EXA_API_KEY=
GITHUB_TOKEN=
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
LARA_ACCESS_KEY_ID=
LARA_ACCESS_KEY_SECRET=
MONGODB_CONNECTION_STRING=
NOTION_TOKEN=
NPS_API_KEY=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
SLACK_MCP_XOXC_TOKEN=
SLACK_MCP_XOXD_TOKEN=
WEATHER_API_KEY=
